{
  "version": "2.0.0",
  // Run any of these with Ctrl+Shift+B (the gate is the default build task)
  // or Ctrl+Shift+P → "Tasks: Run Task".
  "tasks": [
    {
      "label": "Gate — full suite (~19 min)",
      "detail": "Every suite, four at a time. Must exit 0 on a clean committed tree before shipping.",
      "type": "shell",
      "command": "node floodroofing/tests/run.mjs",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Gate — sheet layout only (~40 s)",
      "detail": "37 shapes; Big-L expects 66 strips. Run this FIRST after any sheet-engine change.",
      "type": "shell",
      "command": "node floodroofing/docs/ci_sheet_tests.js",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Gate — one suite by name",
      "detail": "e.g. quoteeditor, gutterprice, pricegold. One name per run.",
      "type": "shell",
      "command": "node floodroofing/tests/run.mjs ${input:suiteName}",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Gate — backend suites only",
      "type": "shell",
      "command": "node floodroofing/tests/run.mjs api",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Check app.html syntax",
      "detail": "Parses every inline <script>. Expect: blocks 6 bad 0. Run after ANY scripted edit.",
      "type": "shell",
      "command": "node floodroofing/tools/check-app-syntax.mjs",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": {
        "owner": "app-html",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^FAIL\\s+(\\S+):(\\d+)\\s+(.*)$",
          "file": 1, "line": 2, "message": 3
        }
      }
    },
    {
      "label": "Sitemap dates (after any public-page change)",
      "detail": "Regenerates sitemap dates from git. Commit the sitemap BEFORE the gate or tests/seo.mjs fails.",
      "type": "shell",
      "command": "node floodroofing/tools/sitemap-dates.mjs",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Sheet shots from a fixture",
      "detail": "Renders a fixture to PNGs of the layout, calc check and cut list. Send these to Aron BEFORE the gate when counts are in question.",
      "type": "shell",
      "command": "node floodroofing/tools/sheet-shots.mjs ${input:fixture}",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Serve the frontend locally (http://localhost:5050/app)",
      "detail": "Static server over floodroofing/frontend. The app still talks to the live API.",
      "type": "shell",
      "command": "npx --yes serve floodroofing/frontend -l 5050",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      // Two steps run in order rather than one "a && b" command: Windows
      // PowerShell 5.1, which is still the default shell on a stock Windows
      // box, rejects && outright ("not a valid statement separator in this
      // version"). dependsOn is shell-agnostic and stops if the first fails.
      "label": "First-time setup (npm ci + Playwright browsers)",
      "dependsOrder": "sequence",
      "dependsOn": ["setup: npm ci", "setup: Playwright browser"],
      "problemMatcher": []
    },
    {
      "label": "setup: npm ci",
      "type": "shell",
      "command": "npm",
      "args": ["ci"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "setup: Playwright browser",
      "type": "shell",
      "command": "npx",
      "args": ["playwright", "install", "chromium"],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "suiteName",
      "type": "promptString",
      "description": "Suite name (one only), e.g. quoteeditor",
      "default": "quoteeditor"
    },
    {
      "id": "fixture",
      "type": "pickString",
      "description": "Which fixture to render",
      "options": [
        "floodroofing/tests/fixtures-report41.json",
        "floodroofing/tests/fixtures-report50.json",
        "floodroofing/tests/fixtures-doublel.json",
        "floodroofing/tests/fixtures-tee.json"
      ],
      "default": "floodroofing/tests/fixtures-report41.json"
    }
  ]
}
